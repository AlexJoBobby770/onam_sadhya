# Database connection (IPv4 Pooler for Supabase, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=sqlite+aiosqlite:///./onam_sadhya.db

# Secret key for JWT tokens and HMAC QR code signatures
SECRET_KEY=super_secret_onam_sadhya_key_2026_change_in_production

# Server & Security settings
DEV_MODE=false
FRONTEND_URL=http://localhost:5173
PORT=8000
HOST=0.0.0.0

# Google OAuth Client ID
GOOGLE_CLIENT_ID=1089123456789-your_google_oauth_client_id.apps.googleusercontent.com

# Super Admin Override Key (For emergency stats access)
SUPER_ADMIN_OVERRIDE_CODE=your_secret_override_token_here

# Supabase Free Tier Storage Settings
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=payment-proofs
